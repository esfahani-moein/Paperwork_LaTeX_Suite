// ---------------------------------------------------------------------------
// Open this folder in VS Code; every paper works in one window. Builds and the
// optional TeXpresso engine run in Docker, never in a host TeX installation.
// ---------------------------------------------------------------------------
{
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  // For continuous TeXpresso use, select "never" to avoid duplicate full builds.
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.autoClean.run": "never",
  "latex-workshop.view.pdf.viewer": "tab",

  "latex-workshop.latex.tools": [
    { "name": "fast", "command": "/bin/sh", "args": ["%WORKSPACE_FOLDER%/bin/paper", "build", "%DOC_EXT%"] },
    { "name": "journal", "command": "/bin/sh", "args": ["%WORKSPACE_FOLDER%/bin/paper", "build", "--journal", "%DOC_EXT%"] }
  ],
  "latex-workshop.latex.recipes": [
    { "name": "Fast build", "tools": ["fast"] },
    { "name": "Journal build (clean, for submission)", "tools": ["journal"] }
  ],

  // shortcut: these paths assume main.tex is directly inside papers/<name>/;
  // use absolute paths in user settings for other project layouts.
  "texpresso.command": "../../bin/texpresso",
  "texpresso.externalCompileCommand": "../../bin/paper build",
  "texpresso.packageProvider": "texlive",
  "texpresso.previewLocation": "editor",
  "texpresso.autoRerun": true,

  "files.exclude": { "**/*.synctex.gz": true }
}
