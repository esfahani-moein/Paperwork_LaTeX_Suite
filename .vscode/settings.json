// ---------------------------------------------------------------------------
// Open this folder in VS Code; every paper works in one window. Builds and the
// optional TeXpresso engine run in Docker, never in a host TeX installation.
// ---------------------------------------------------------------------------
{
  // Use this project's uv-managed environment. VS Code accepts the .venv
  // directory here and resolves the platform-specific interpreter itself.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  "python.terminal.activateEnvironment": true,
  "python-envs.workspaceSearchPaths": ["./.venv"],

  // Let the Astral ty extension provide Python language services in this workspace.
  "python.languageServer": "None",
  "ty.importStrategy": "fromEnvironment",
  "ty.path": [
    "${workspaceFolder}/.venv/bin/ty",
    "${workspaceFolder}/.venv/Scripts/ty.exe"
  ],

  // This repository uses a src/ package layout.
  "python.analysis.extraPaths": ["${workspaceFolder}/src"],

  // Ruff owns formatting, lint fixes, and import sorting for Python files.
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },

  // Use pytest from the selected project interpreter.
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // Hide generated files in the Explorer without excluding source from analysis.
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.egg-info": true,
    "**/.venv": true
  },

  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  // For continuous TeXpresso use, select "never" to avoid duplicate full builds.
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.autoClean.run": "never",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.outDir": "%DIR%/publication",

  "latex-workshop.latex.tools": [
    { "name": "fast", "command": "/bin/sh", "args": ["%WORKSPACE_FOLDER%/bin/paper", "build", "%DOC_EXT%"] },
    { "name": "journal", "command": "/bin/sh", "args": ["%WORKSPACE_FOLDER%/bin/paper", "build", "--journal", "%DOC_EXT%"] }
  ],
  "latex-workshop.latex.recipes": [
    { "name": "Fast build", "tools": ["fast"] },
    { "name": "Journal build (clean, for submission)", "tools": ["journal"] }
  ],

  // shortcut: these paths assume main.tex is directly inside papers/<name>/;
  // use absolute paths in user settings for other project layouts.
  "texpresso.command": "../../bin/texpresso",
  "texpresso.externalCompileCommand": "../../bin/paper build",
  "texpresso.packageProvider": "texlive",
  "texpresso.previewLocation": "editor",
  "texpresso.autoRerun": true,

  "files.exclude": { "**/*.synctex.gz": true }
}
