# ---------------------------------------------------------------------------
# paper.env: project settings (plain KEY=VALUE, "#" starts a comment).
# Read by compose.yaml (container) and by paperbuild (per build).
# A paper can override ENGINE / SHELL_ESCAPE / MAIN / TEXLIVE with its own
# papers/<name>/paper.env. After changing container settings run: bin/paper up
# ---------------------------------------------------------------------------

# Default engine: auto | pdflatex | lualatex | xelatex | tectonic
# auto = lualatex if the paper uses fontspec/unicode-math, else pdflatex (fastest).
ENGINE=auto

# 1 = allow packages that run programs (minted, svg). Off by default for safety.
SHELL_ESCAPE=0

# --- Container settings (apply with: bin/paper up) ---
# TeX Live size: scheme-full (everything, ~5 GB) | scheme-medium | scheme-small. Apply with: bin/paper rebuild
TEXLIVE_SCHEME=scheme-full
CPUS=4
MEMORY=4g
# RAM disk for temporary build files
BUILD_RAM=2g
# bridge = internet (Tectonic downloads packages on demand). none = fully offline:
# TeX Live engines work as usual; Tectonic then only has what was pre-fetched in the image.
# With SHELL_ESCAPE=0, TeX itself cannot reach the network either way.
NETWORK=bridge
