# ---------------------------------------------------------------------------
# Project-wide settings. Papers may override ENGINE / SHELL_ESCAPE / MAIN.
# Image settings take effect with: bin/paper rebuild
# Container settings take effect with: bin/paper up
# ---------------------------------------------------------------------------

# TeX Live distribution installed in the single image: latest or a four-digit year.
TEXLIVE=latest
TEXLIVE_SCHEME=scheme-full

# auto uses pdfLaTeX. Other choices: pdflatex | lualatex | xelatex | tectonic.
ENGINE=auto

# 1 = allow packages that run programs (minted, svg). Off by default for safety.
SHELL_ESCAPE=0

# Shared container resources.
CPUS=4
MEMORY=4g
BUILD_RAM=2g

# bridge = Tectonic can download packages; none = fully offline.
# With SHELL_ESCAPE=0, TeX itself cannot reach the network either way.
NETWORK=bridge
