#!/bin/sh
# ---------------------------------------------------------------------------
# bin/paper: the only public host command. Manage the shared container, create
# papers, and run build/authoring tools without installing TeX on the host.
# ---------------------------------------------------------------------------
set -eu
root=$(cd "$(dirname "$0")/.." && pwd -P)
dc() { PAPER_ROOT=$root docker compose --project-directory "$root" --env-file "$root/paper.env" "$@"; }
command -v docker >/dev/null 2>&1 || { echo "paper: Docker not found. Start OrbStack first." >&2; exit 2; }

usage() {
  cat <<'EOF'
Usage: bin/paper <command> [arguments]
  new <name> [--template <name>]  Create a paper (default template: article)
  build [--journal] <file.tex>    Build a normal or clean submission PDF
  fmt <file.tex>                  Format LaTeX source
  check <file.tex>                Lint LaTeX source
  count <file.tex>                Count words
  diff <old.tex> <new.tex>        Show source differences
  tectonic [arguments]            Run Tectonic directly
  up | down                       Start or stop the shared container
  rebuild                         Rebuild the selected TeX Live image
  doctor                          Validate the container and installed tools
EOF
}

workdir() {
  here=$(pwd -P)
  case "$here/" in "$root"/*) ;; *) echo "paper: run inside $root" >&2; exit 2 ;; esac
}

run() {
  workdir
  # Fast path: one Docker call. Retry only when the container was not running.
  # shortcut: a retry loses piped stdin; upgrade if formatter pipes become common.
  docker exec -i -w "$here" paper-latex "$@" && return 0 || rc=$?
  [ "$(docker container inspect -f '{{.State.Running}}' paper-latex 2>/dev/null)" = true ] && return "$rc"
  echo "paper: starting the compile container..." >&2
  dc up -d paper >&2
  exec docker exec -i -w "$here" paper-latex "$@"
}

cmd=${1:-help}
[ $# -eq 0 ] || shift
case "$cmd" in
  new)
    name=${1:-}; template=article
    if [ $# -eq 3 ] && [ "$2" = --template ]; then template=$3
    elif [ $# -ne 1 ]; then usage >&2; exit 2; fi
    case "$name" in ''|.|..|*[!A-Za-z0-9._-]*) echo "paper: invalid paper name" >&2; exit 2 ;; esac
    case "$template" in ''|.|..|*[!A-Za-z0-9._-]*) echo "paper: invalid template name" >&2; exit 2 ;; esac
    [ -d "$root/templates/$template" ] || { echo "paper: unknown template '$template'" >&2; exit 2; }
    [ ! -e "$root/papers/$name" ] || { echo "paper: papers/$name already exists" >&2; exit 2; }
    mkdir -p "$root/papers"
    cp -R "$root/templates/$template" "$root/papers/$name"
    echo "Created papers/$name from $template"
    ;;
  build) run paperbuild "$@" ;;
  fmt) run tex-fmt "$@" ;;
  check) run chktex "$@" ;;
  count) run texcount "$@" ;;
  diff) run latexdiff "$@" ;;
  tectonic) run tectonic "$@" ;;
  up) dc up -d paper ;;
  down) dc down ;;
  rebuild)
    BUILD_ID=${BUILD_ID:-$(date -u +%Y%m%d%H%M%S)}
    export BUILD_ID
    dc build --pull --no-cache paper && dc up -d --force-recreate paper
    ;;
  doctor)
    dc config -q
    dc up -d paper
    docker exec paper-latex sh -c '
      for tool in paperbuild latexmk tectonic tex-fmt chktex texcount latexdiff texpresso texpresso-xetex; do
        command -v "$tool" >/dev/null || { echo "missing: $tool" >&2; exit 1; }
      done
      texpresso -capabilities >/dev/null
      echo "paper: OK (TeX Live $PAPER_TEXLIVE, image $PAPER_IMAGE_ID)"
    '
    ;;
  _texpresso)
    workdir
    dc up -d paper >&2
    exec docker exec -i -w "$here" paper-latex texpresso "$@"
    ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
