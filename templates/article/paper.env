# Settings for THIS paper only (override the project's paper.env). Uncomment to use.
# Engine: pdflatex | lualatex | xelatex | tectonic
# ENGINE=xelatex
# Main file when it is not main.tex
# MAIN=thesis.tex
# 1 = allow minted/svg packages that run programs
# SHELL_ESCAPE=1
# Frozen TeX Live year a journal requires (needs a matching service in compose.yaml)
# TEXLIVE=2025
